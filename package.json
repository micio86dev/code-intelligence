{
  "name": "code-intelligence",
  "version": "0.1.0",
  "description": "Agent-agnostic CLI that runs mature security and quality scanners on what changed, normalizes the findings, and reports only what matters.",
  "license": "MIT",
  "author": "micio86dev",
  "type": "module",
  "bin": {
    "code-intel": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micio86dev/code-intelligence.git"
  },
  "homepage": "https://github.com/micio86dev/code-intelligence#readme",
  "bugs": {
    "url": "https://github.com/micio86dev/code-intelligence/issues"
  },
  "keywords": [
    "security",
    "sast",
    "secrets",
    "sarif",
    "static-analysis",
    "mutation-testing",
    "ai-agents",
    "cli"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.ts\"",
    "test:all": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "npm run build",
    "test:install": "node --test --test-concurrency=1 \"test/install/**/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
